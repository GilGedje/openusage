{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quota by Exodus.Ai",
  "version": "0.1.0",
  "identifier": "io.github.gilgedje.litellm-usage",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "panel",
        "title": "Quota by Exodus.Ai",
        "url": "index.html",
        "width": 320,
        "height": 420,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Your Claude budget and usage in the tray",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    },
    "linux": {
      "deb": {
        "conflicts": [
          "lite-llm-usage"
        ],
        "replaces": [
          "lite-llm-usage"
        ]
      }
    }
  },
  "mainBinaryName": "litellm-usage"
}
